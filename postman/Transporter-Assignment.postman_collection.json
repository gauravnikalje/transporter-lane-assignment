                  "pm.test(\"transporters [1, 4, 5]\", () => pm.expect(pm.response.json().selectedTransporters).to.eql([1, 4, 5]));",
                  "pm.test(\"proven optimal\", () => pm.expect(pm.response.json().optimal).to.eql(true));"
                ]
              }
